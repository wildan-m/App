+// Releases the `updatingModals` guard of a modal update whose UIKit transition was refused, and applies the current
+// modal state again. Runs once, after the transition that blocked the request ends, or on the next main queue turn
+// when no transition is visible. `isStillDropped` is checked first: UIKit may have only deferred the request, and
+// then its completion releases the guard as usual.
+- (void)releaseModalsUpdate:(NSUInteger)generation
+          afterTransitionOf:(UIViewController *)controller
+             ifStillDropped:(BOOL (^)(void))isStillDropped
+{
+  __weak RNSScreenStackView *weakSelf = self;
+  void (^retry)(void) = ^{
+    RNSScreenStackView *strongSelf = weakSelf;
+    if (strongSelf == nil || !strongSelf->_updatingModals || strongSelf->_modalsUpdateGeneration != generation ||
+        !isStillDropped()) {
+      return;
+    }
+    strongSelf->_updatingModals = NO;
+    strongSelf->_scheduleModalsUpdate = NO;
+    [strongSelf updateContainer];
+  };
+
+  UIViewController *topMostVc = [RNSScreenStackView findTopMostPresentedViewControllerFromViewController:controller];
+  id<UIViewControllerTransitionCoordinator> coordinator =
+      controller.transitionCoordinator ?: topMostVc.transitionCoordinator;
+  if (coordinator != nil &&
+      [coordinator animateAlongsideTransition:nil
+                                   completion:^(id<UIViewControllerTransitionCoordinatorContext> _) {
+                                     dispatch_async(dispatch_get_main_queue(), retry);
+                                   }]) {
+    return;
+  }
+  dispatch_async(dispatch_get_main_queue(), retry);
+}
